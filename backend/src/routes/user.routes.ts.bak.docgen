import { Router } from 'express';
import multer from 'multer';
import path from 'path';
import { existsSync, mkdirSync } from 'fs';
import { PrismaClient } from '@prisma/client';
import { UserController } from '../controllers/user.controller';
import { authenticate, authorize } from '../middlewares/auth.middleware';

const r = Router();
const c = new UserController();
const prisma = new PrismaClient();

// ─── ID-card photo upload setup ─────────────────────────
const ID_CARD_DIR = '/app/uploads/id-cards';
if (!existsSync(ID_CARD_DIR)) mkdirSync(ID_CARD_DIR, { recursive: true });

const idCardStorage = multer.diskStorage({
  destination: (_req, _file, cb) => cb(null, ID_CARD_DIR),
  filename: (req, file, cb) => {
    const ext = path.extname(file.originalname).toLowerCase();
    const userId = req.params.id;
    cb(null, `idcard-${userId}-${Date.now()}${ext}`);
  },
});
const idCardUpload = multer({
  storage: idCardStorage,
  limits: { fileSize: 10 * 1024 * 1024 },
  fileFilter: (_req, file, cb) => {
    if (/^image\//.test(file.mimetype)) cb(null, true);
    else cb(new Error('Only image files allowed'));
  },
});

r.use(authenticate);

// Existing routes
r.get('/', (req, res) => c.list(req, res));
r.post('/', authorize('ADMIN'), (req, res) => c.create(req, res));
r.patch('/:id', authorize('ADMIN'), (req, res) => c.update(req, res));
r.post('/:id/reset-password', authorize('ADMIN'), (req, res) => c.resetPassword(req, res));

// ─── New routes: document profile + ID card photo ───────
// Anyone authenticated can update their team-member profile fields
// (admins can update anyone's; non-admins typically only update self — handled at app level)
r.patch('/:id/profile', async (req, res) => {
  try {
    const { idCard, position, phoneForDoc, fullName, phoneNumber } = req.body;
    const updated = await prisma.user.update({
      where: { id: req.params.id },
      data: {
        ...(idCard !== undefined ? { idCard } : {}),
        ...(position !== undefined ? { position } : {}),
        ...(phoneForDoc !== undefined ? { phoneForDoc } : {}),
        ...(fullName !== undefined ? { fullName } : {}),
        ...(phoneNumber !== undefined ? { phoneNumber } : {}),
      },
      select: {
        id: true, fullName: true, email: true, role: true,
        idCard: true, idCardPhotoUrl: true, position: true,
        phoneNumber: true, phoneForDoc: true,
      },
    });
    res.json({ success: true, data: updated });
  } catch (err: any) {
    res.status(500).json({ success: false, message: err.message });
  }
});

r.post('/:id/id-card-photo', idCardUpload.single('photo'), async (req, res) => {
  try {
    const file = (req as any).file;
    if (!file) {
      res.status(400).json({ success: false, message: 'No file uploaded' });
      return;
    }
    const url = `/uploads/id-cards/${file.filename}`;
    const updated = await prisma.user.update({
      where: { id: req.params.id },
      data: { idCardPhotoUrl: url },
      select: { id: true, fullName: true, idCard: true, idCardPhotoUrl: true },
    });
    res.json({ success: true, data: updated });
  } catch (err: any) {
    res.status(500).json({ success: false, message: err.message });
  }
});

export default r;
