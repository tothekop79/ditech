generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  password              String
  fullName              String
  phone                 String?
  role                  UserRole               @default(INSTALLER)
  isActive              Boolean                @default(true)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  idCard                String?
  idCardPhotoUrl        String?
  phoneForDoc           String?
  position              String?
  province              String?
  createdDocs           Document[]             @relation("DocCreatedBy")
  createdEvents         Event[]                @relation("EventCreatedBy")
  triggeredEventReports EventReport[]          @relation("EventReportTriggeredBy")
  assignedPlans         InstallationPlan[]     @relation("AssignedPlans")
  createdPlans          InstallationPlan[]     @relation("CreatedPlans")
  planChanges           PlanStatusHistory[]
  ledTeams              Team[]                 @relation("TeamLead")
  teamMemberships       TeamMember[]
  recordedComms         PlanCommunicationLog[] @relation("RecordedComms")
  uploadedPhotos        PlanPhoto[]            @relation("UploadedPhotos")
  // ─── C1.1 BACK-RELATIONS ─── User
  designsCreated        InstallationDesign[]   @relation("DesignsCreated")
  designsChecked        InstallationDesign[]   @relation("DesignsChecked")
}

model Customer {
  id                String             @id @default(uuid())
  customerCode      String             @unique
  customerName      String
  contactPerson     String?
  contactPhone      String?
  logoUrl           String?
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  contactEmail      String?
  events            Event[]
  installationPlans InstallationPlan[]

  @@index([customerCode])
  @@index([isActive])
}

model Department {
  id                String             @id @default(uuid())
  departmentCode    String             @unique
  departmentName    String
  departmentType    DepartmentType     @default(DEPARTMENT_STORE)
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  installationPlans InstallationPlan[]

  @@index([departmentCode])
}

model Team {
  id             String             @id @default(uuid())
  name           String             @unique
  region         StoreRegion
  dailyCap       Int                @default(1)
  leadUserId     String?
  telegramChatId String?
  isActive       Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  assignedPlans  InstallationPlan[] @relation("TeamPlans")
  leadUser       User?              @relation("TeamLead", fields: [leadUserId], references: [id])
  members        TeamMember[]
}

model TeamMember {
  teamId String
  userId String
  role   String @default("MEMBER")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([teamId, userId])
}

model InstallationPlan {
  id                String                 @id @default(uuid())
  customerId        String
  departmentId      String
  storeName         String
  storeRegion       StoreRegion            @default(BANGKOK)
  province          String?
  address           String?
  contactPerson     String?
  contactPhone      String?
  description       String
  workScope         WorkScope[]
  sensorCount       Int                    @default(0)
  durationDays      Int                    @default(1)
  readiness         PlanReadiness          @default(PENDING)
  readinessNote     String?
  detail            String?
  trackingResult    String?
  scheduledDate     DateTime?
  completedDate     DateTime?
  planStatus        PlanStatus             @default(DRAFT)
  teamId            String?
  assignedById      String?
  contractorName    String?
  createdById       String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  branchName        String?
  poeSwitchModel    String?
  sensorModel       String?
  contactEmail      String?
  contactLine       String?
  workEndTime       String?
  workStartTime     String?
  provinceId        String?
  regionId          String?
  eventId           String?
  documents         Document[]
  assignedBy        User?                  @relation("AssignedPlans", fields: [assignedById], references: [id])
  createdBy         User?                  @relation("CreatedPlans", fields: [createdById], references: [id])
  customer          Customer               @relation(fields: [customerId], references: [id])
  department        Department             @relation(fields: [departmentId], references: [id])
  event             Event?                 @relation(fields: [eventId], references: [id])
  provinceRel       Province?              @relation(fields: [provinceId], references: [id])
  region            Region?                @relation(fields: [regionId], references: [id])
  team              Team?                  @relation("TeamPlans", fields: [teamId], references: [id])
  statusHistory     PlanStatusHistory[]
  communicationLogs PlanCommunicationLog[]
  photos            PlanPhoto[]
  // ─── C1.1 BACK-RELATIONS ─── InstallationPlan
  designs           InstallationDesign[]   @relation("PlanDesigns")

  @@index([customerId])
  @@index([departmentId])
  @@index([readiness])
  @@index([planStatus])
  @@index([scheduledDate])
  @@index([storeRegion])
  @@index([regionId])
  @@index([provinceId])
  @@index([teamId])
  @@index([eventId])
}

model PlanStatusHistory {
  id           String           @id @default(uuid())
  planId       String
  fieldChanged String
  oldValue     String?
  newValue     String
  changedById  String?
  changedAt    DateTime         @default(now())
  note         String?
  changedBy    User?            @relation(fields: [changedById], references: [id])
  plan         InstallationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([changedAt])
}

model NotificationRule {
  id               String              @id @default(uuid())
  name             String
  description      String?
  enabled          Boolean             @default(true)
  trigger          NotificationTrigger
  triggerTime      String?
  triggerDay       String?
  triggerCondition String?
  daysAhead        Int?
  recipients       String[]
  templateBody     String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  logs             NotificationLog[]
}

model NotificationLog {
  id            String             @id @default(uuid())
  ruleId        String?
  recipient     String
  channel       String             @default("TELEGRAM")
  subject       String?
  body          String
  attachmentUrl String?
  status        NotificationStatus @default(PENDING)
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())
  rule          NotificationRule?  @relation(fields: [ruleId], references: [id])

  @@index([ruleId])
  @@index([status])
  @@index([sentAt])
}

model PlanCommunicationLog {
  id            String           @id @default(uuid())
  planId        String           @map("plan_id")
  channel       String
  direction     String
  contactedAt   DateTime         @default(now()) @map("contacted_at")
  contactPerson String?          @map("contact_person")
  summary       String
  outcome       String?
  recordedById  String?          @map("recorded_by_id")
  createdAt     DateTime         @default(now()) @map("created_at")
  plan          InstallationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  recordedBy    User?            @relation("RecordedComms", fields: [recordedById], references: [id])

  @@index([planId])
  @@map("plan_communication_logs")
}

model PlanPhoto {
  id           String           @id @default(uuid())
  planId       String           @map("plan_id")
  category     String
  caption      String?
  filename     String
  storagePath  String           @map("storage_path")
  mimeType     String           @map("mime_type")
  fileSize     Int              @map("file_size")
  uploadedById String?          @map("uploaded_by_id")
  createdAt    DateTime         @default(now()) @map("created_at")
  plan         InstallationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  uploadedBy   User?            @relation("UploadedPhotos", fields: [uploadedById], references: [id])

  @@index([planId])
  @@map("plan_photos")
}

model Document {
  id                  String           @id @default(uuid())
  planId              String
  docType             DocType
  docNumber           String           @unique
  payload             Json
  status              DocStatus        @default(DRAFT)
  createdById         String?
  finalizedAt         DateTime?
  signedAt            DateTime?
  signedByName        String?
  pdfUrl              String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  notes               String?
  poeCount            Int?
  workEndTime         String?
  workStartTime       String?
  equipmentList       Json?
  handoverChecklist   Json?
  preInstallChecklist Json?
  workingChecklist    Json?
  createdBy           User?            @relation("DocCreatedBy", fields: [createdById], references: [id])
  plan                InstallationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([docType])
  @@index([status])
}

model DocumentSequence {
  date    String @id
  lastSeq Int
}

model Region {
  id        String             @id @default(uuid())
  code      String             @unique
  name      String
  nameThai  String
  sortOrder Int                @default(0)
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  plans     InstallationPlan[]
  provinces Province[]

  @@index([code])
}

model Province {
  id        String             @id @default(uuid())
  code      String             @unique
  name      String
  nameThai  String
  regionId  String
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
  plans     InstallationPlan[]
  region    Region             @relation(fields: [regionId], references: [id])

  @@index([regionId])
  @@index([code])
}

model Event {
  id                     String               @id @default(uuid())
  name                   String
  organizer              String?
  venue                  String?
  venueType              String               @default("Booth")
  startDate              DateTime
  endDate                DateTime
  status                 EventStatus          @default(PLANNING)
  profile                EventProfile         @default(FULL)
  description            String?
  systemCredit           String               @default("AI People Counting")
  confidential           Boolean              @default(true)
  showPasserby           Boolean              @default(true)
  displayHoursStart      Int                  @default(9)
  displayHoursEnd        Int                  @default(19)
  dwellMinSec            Int                  @default(0)
  dwellMaxSec            Int                  @default(3600)
  engagementThresholdSec Int                  @default(60)
  excludeStaff           Boolean              @default(true)
  showDwellBenchmark     Boolean              @default(false)
  sponsorZones           String?
  customerId             String?
  createdById            String?
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  createdBy              User?                @relation("EventCreatedBy", fields: [createdById], references: [id])
  customer               Customer?            @relation(fields: [customerId], references: [id])
  activities             EventActivity[]
  days                   EventDay[]
  gates                  EventGate[]
  reports                EventReport[]
  zones                  EventZone[]
  plans                  InstallationPlan[]
  // ─── C1.1 BACK-RELATIONS ─── Event
  designs                InstallationDesign[] @relation("EventDesigns")

  @@index([startDate])
  @@index([status])
  @@index([customerId])
}

model EventDay {
  id        String   @id @default(uuid())
  eventId   String
  dayNumber Int
  date      DateTime
  label     String
  color     String   @default("#1F77B4")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, dayNumber])
  @@index([eventId])
}

model EventGate {
  id        String @id @default(uuid())
  eventId   String
  name      String
  gateType  String @default("ENTRANCE")
  sortOrder Int    @default(0)
  event     Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventZone {
  id                String  @id @default(uuid())
  eventId           String
  name              String
  abbrev            String?
  description        String?
  dwellBenchmarkSec  Int?
  dwellBenchmarkMode String?
  sortOrder          Int     @default(0)
  event     Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventActivity {
  id          String   @id @default(uuid())
  eventId     String
  date        DateTime
  startTime   String
  endTime     String
  name        String
  zone        String?
  description String?
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, date])
}

model EventReport {
  id            String            @id @default(uuid())
  eventId       String
  status        EventReportStatus @default(QUEUED)
  profile       String            @default("full")
  rawdataPath   String?
  htmlPath      String?
  xlsxPath      String?
  htmlSize      Int?
  xlsxSize      Int?
  queuedAt      DateTime          @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?
  stdout        String?
  stderr        String?
  errorMessage  String?
  triggeredById String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  event         Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  triggeredBy   User?             @relation("EventReportTriggeredBy", fields: [triggeredById], references: [id])

  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  INSTALLER
  QA
  CUSTOMER
}

enum DepartmentType {
  DEPARTMENT_STORE
  HYPERMARKET
  SPECIALTY_STORE
  SHOPPING_MALL
  OTHER
}

enum StoreRegion {
  BANGKOK
  UPC
}

enum WorkScope {
  INSTALL_CAMERA
  INSTALL_LAN
  INSTALL_POE
  CALIBRATION
  TESTING
  CLOUD_SETUP
  MAINTENANCE
}

enum PlanReadiness {
  PENDING
  NOT_READY
  READY
  ON_HOLD
}

enum PlanStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum NotificationTrigger {
  DAILY_AT
  EVENING_DAY_BEFORE
  WEEKLY_AT
  STATUS_CHANGE
  READINESS_READY
  NOT_READY_NEAR
  CAPACITY_OVERFLOW
  HANDOVER_GENERATED
  RESCHEDULED
  TEAM_CHANGED
  PLAN_CREATED
  PHOTO_UPLOADED
  EVENT_REPORT_READY
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum DocType {
  WORK_PERMIT
  INSTALLATION_CONFIRM
}

enum DocStatus {
  DRAFT
  FINALIZED
  SIGNED
}

enum EventStatus {
  PLANNING
  IN_PROGRESS
  DATA_COLLECTED
  REPORT_READY
  COMPLETED
  CANCELLED
}

enum EventProfile {
  SIMPLE
  STANDARD
  FULL
}

enum EventReportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

// ═══════════════════════════════════════════════════
// Coverage Simulator — Phase C1.1
// ═══════════════════════════════════════════════════

//   Used across designs (one model = many sensor placements).
// ─────────────────────────────────────────────────────────────────
model CameraModel {
  id String @id @default(uuid())

  brand     String // 'Vionvision' | 'Hikvision' | 'Other'
  modelName String // 'G6', 'G5', 'DS-2CD6425G0', etc.
  variant   String? // 'White' | 'Black' | null

  displayName String // computed: "Vionvision G6 (White)"

  // Coverage table — array of {height, width, depth} rows
  // Used to interpolate coverage rect at any mounting height
  coverageTable Json // CoverageRow[]

  // Specs
  minHeight   Float   @default(2.5)
  maxHeight   Float   @default(4.6)
  resolution  String? // '3840x2160@25fps'
  powerSupply String? // 'PoE / DC12V'
  notes       String? @db.Text

  // Function compatibility (which sensor functions can use this model)
  // ['entrance', 'engagement', 'heatmap', 'cctv', 'passerby']
  supportedFunctions String[] @default(["entrance", "engagement", "heatmap"])

  // Visual
  imageUrl  String? // uploaded camera image (per model, not per sensor)
  iconColor String? // hex for symbol display, e.g. "#3b82f6"

  isActive Boolean @default(true)
  isSystem Boolean @default(false) // true for built-in (G5/G6/Hikvision)

  // Reverse relation
  sensors SensorPlacement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([brand, modelName, variant])
  @@index([brand, modelName])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────
// InstallationDesign — one design per plan/event (or standalone)
//   Holds floor plan + sensors + zones + calculated coverage stats.
// ─────────────────────────────────────────────────────────────────
model InstallationDesign {
  id String @id @default(uuid())

  // Optional links — one design can be tied to a plan, event, both, or neither
  planId  String?
  plan    InstallationPlan? @relation("PlanDesigns", fields: [planId], references: [id], onDelete: SetNull)
  eventId String?
  event   Event?            @relation("EventDesigns", fields: [eventId], references: [id], onDelete: SetNull)

  // Site info
  siteName     String
  storeType    String? // 'department_store' | 'shopping_mall' | 'event_booth' | etc
  designNumber String? // 'Design 01', auto-incremented per plan/event
  version      String  @default("v1.0")

  // Floor plan
  floorPlanUrl    String? // uploaded PNG/JPG path
  floorPlanWidth  Int? // px (image natural size)
  floorPlanHeight Int? // px
  ceilingHeight   Float   @default(3.0)
  entranceHeight  Float? // entrance opening height in m (for obstruction calc)
  entranceWidth   Float? // entrance opening width in m
  scalePxPerMeter Float   @default(20) // 20 px = 1m, i.e. 1px = 0.05m default

  // People involved
  designerId  String?
  designer    User?   @relation("DesignsCreated", fields: [designerId], references: [id], onDelete: SetNull)
  checkedById String?
  checkedBy   User?   @relation("DesignsChecked", fields: [checkedById], references: [id], onDelete: SetNull)

  // Calculated coverage stats (computed from sensors + zones)
  entranceCoveragePercent   Float?
  engagementCoveragePercent Float?
  heatmapCoveragePercent    Float?
  overallStatus             String? // 'PASS' | 'WARNING' | 'FAIL'
  recommendations           Json? // string[] — auto-generated suggestions

  // Notes
  installationNote String? @db.Text

  // Relations
  sensors SensorPlacement[]
  zones   CoverageZone[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([eventId])
  @@index([overallStatus])
}

// ─────────────────────────────────────────────────────────────────
// SensorPlacement — one sensor placed on the floor plan
// ─────────────────────────────────────────────────────────────────
model SensorPlacement {
  id String @id @default(uuid())

  designId String
  design   InstallationDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  cameraModelId String
  cameraModel   CameraModel @relation(fields: [cameraModelId], references: [id])

  sensorName   String // 'Sensor1' (user editable, not unique globally)
  functionType String // 'entrance' | 'engagement' | 'heatmap' | 'cctv' | 'passerby' | 'zone'
  mountingType String // 'embedded' | 'surface' | 'bracket' | 'tilt_bracket'

  // Position on floor plan (px)
  x              Float
  y              Float
  rotation       Float @default(0) // yaw in degrees, 0 = up
  mountingHeight Float @default(3.0)
  tiltAngle      Float @default(0) // pitch tilt for bracket mount

  // Coverage rectangle (auto from model+height, or manually overridden)
  coverageWidth    Float // m
  coverageDepth    Float // m
  coverageOverride Boolean @default(false)
  // anchorMode: where the sensor sits relative to its coverage rect
  //   'center'    — sensor at center of rect (top-down camera, standard)
  //   'back_edge' — sensor at back of rect (looking forward, e.g. tilted)
  //   'front_edge'— sensor at front of rect
  anchorMode       String  @default("center")

  // Obstruction check (entrance sensors only)
  color              String? // Per-sensor color override (CSS hex)
  nearEdgeRatio      Float    @default(0.47) // Trapezoid near/far edge ratio (for tilt_bracket)
  obstructionData    Json? // { ceilingHeight, camHeight, obstrDrop, camIn, targetOut, targetHeight, margin, type
  // C1.8 — Coverage rendering options
  coverageMode       String   @default("rectangle")
  showLabels         Boolean  @default(true)
  showDimensions     Boolean  @default(true)
  showDirectionArrow Boolean  @default(true)

  // C1.10d#3 — Manual trapezoid ratio override (tilt_projection only).
  // When ratioOverride=true AND coverageMode='tilt_projection', the service
  // bypasses the tilt lookup table and uses these multipliers of the base
  // coverage (from camera spec table at current mountingHeight):
  //   farWidth = baseWidth * farWidthRatio
  //   depth    = baseDepth * depthRatio
  //   nearEdgeRatio above already stores nearWidth/farWidth (reused).
  // When ratioOverride=false, applyTiltProjection(tilt) runs as before.
  ratioOverride  Boolean @default(false)
  farWidthRatio  Float?  // multiplier of base width (~0.5-2.0)
  depthRatio     Float?  // multiplier of base depth (~0.5-2.5)

  obstructionPass    Boolean?
  obstructionNote    String?

  // Display
  showAsImage Boolean @default(false) // toggle: image overlay vs symbol dot

  // Status
  status String  @default("PASS") // 'PASS' | 'WARNING' | 'FAIL'
  note   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([designId])
  @@index([cameraModelId])
  @@index([functionType])
}

// ─────────────────────────────────────────────────────────────────
// CoverageZone — a region on the floor plan to evaluate coverage against
//   Examples:
//     entrance_line  — line drawn across door opening (people-counting target)
//     engagement_area — polygon around a display table or product zone
//     heatmap_area   — walking area for store-wide heatmap
//     walking_area   — overall walkable floor (default = full floor)
//     obstruction    — area to exclude (pillars, fixtures)
// ─────────────────────────────────────────────────────────────────
model CoverageZone {
  id String @id @default(uuid())

  designId String
  design   InstallationDesign @relation(fields: [designId], references: [id], onDelete: Cascade)

  zoneType String // see enum-like values in comment above
  name     String? // user label, e.g. "Front entrance line"

  // Geometry — exactly one of these must be set
  linePoints Json? // [{x, y}, {x, y}] for entrance_line
  polygon    Json? // [{x, y}, {x, y}, ...] for areas

  // Calculated
  coveragePercent Float? // % of zone covered by sensors
  status          String? // 'PASS' | 'WARNING' | 'FAIL'

  // Optional metadata
  metadata Json? // free-form, e.g. { lineWidthM: 8.6 }

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([designId])
  @@index([zoneType])
}
