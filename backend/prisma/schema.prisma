generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// User & Auth
// ============================================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  fullName  String
  phone     String?
  role      UserRole @default(INSTALLER)
  isActive  Boolean  @default(true)

  teamMemberships TeamMember[]
  ledTeams        Team[]              @relation("TeamLead")
  assignedPlans   InstallationPlan[]  @relation("AssignedPlans")
  createdPlans    InstallationPlan[]  @relation("CreatedPlans")
  planChanges     PlanStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  recordedComms     PlanCommunicationLog[] @relation("RecordedComms")
  uploadedPhotos    PlanPhoto[]            @relation("UploadedPhotos")
  idCard         String?
  idCardPhotoUrl String?
  position       String?
  phoneForDoc    String?
  province       String?
  createdDocs Document[] @relation("DocCreatedBy")

  createdEvents              Event[]         @relation("EventCreatedBy")
  triggeredEventReports      EventReport[]   @relation("EventReportTriggeredBy")
}

enum UserRole {
  ADMIN
  PROJECT_MANAGER
  INSTALLER
  QA
  CUSTOMER
}

// ============================================================
// Master data
// ============================================================

model Customer {
  id            String  @id @default(uuid())
  customerCode  String  @unique
  customerName  String
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  logoUrl       String?
  isActive      Boolean @default(true)

  installationPlans InstallationPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerCode])
  @@index([isActive])

  events            Event[]
}

model Department {
  id             String         @id @default(uuid())
  departmentCode String         @unique
  departmentName String
  departmentType DepartmentType @default(DEPARTMENT_STORE)
  isActive       Boolean        @default(true)

  installationPlans InstallationPlan[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([departmentCode])
}

enum DepartmentType {
  DEPARTMENT_STORE
  HYPERMARKET
  SPECIALTY_STORE
  SHOPPING_MALL
  OTHER
}

// ============================================================
// Teams
// ============================================================

model Team {
  id             String      @id @default(uuid())
  name           String      @unique
  region         StoreRegion
  dailyCap       Int         @default(1)
  leadUserId     String?
  leadUser       User?       @relation("TeamLead", fields: [leadUserId], references: [id])
  telegramChatId String?
  isActive       Boolean     @default(true)

  members       TeamMember[]
  assignedPlans InstallationPlan[] @relation("TeamPlans")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TeamMember {
  teamId String
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   String @default("MEMBER")

  @@id([teamId, userId])
}

// ============================================================
// Installation Plan (core domain)
// ============================================================

model InstallationPlan {
  id            String      @id @default(uuid())
  customerId    String
  customer      Customer    @relation(fields: [customerId], references: [id])
  departmentId  String
  department    Department  @relation(fields: [departmentId], references: [id])

  storeName     String
  branchName    String?
  storeRegion   StoreRegion @default(BANGKOK)
  // K4 phase 1: new region/province relations (existing storeRegion + province kept)
  regionId      String?
  region        Region?     @relation(fields: [regionId], references: [id], onDelete: SetNull)
  provinceId    String?
  provinceRel   Province?   @relation(fields: [provinceId], references: [id], onDelete: SetNull)
  province      String?
  address       String?
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  contactLine   String?

  description   String
  workScope     WorkScope[]
  sensorCount   Int         @default(0)
  sensorModel   String?
  poeSwitchModel String?
  durationDays  Int         @default(1)
  workStartTime String?
  workEndTime   String?

  readiness     PlanReadiness @default(PENDING)
  readinessNote String?
  detail        String?       @db.Text
  trackingResult String?      @db.Text

  scheduledDate DateTime?
  completedDate DateTime?
  planStatus    PlanStatus    @default(DRAFT)

  teamId        String?
  team          Team?         @relation("TeamPlans", fields: [teamId], references: [id], onDelete: SetNull)
  assignedById  String?
  assignedBy    User?         @relation("AssignedPlans", fields: [assignedById], references: [id], onDelete: SetNull)
  contractorName String?

  createdById   String?
  createdBy     User?         @relation("CreatedPlans", fields: [createdById], references: [id], onDelete: SetNull)

  statusHistory PlanStatusHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  communicationLogs PlanCommunicationLog[]
  photos            PlanPhoto[]


  // M1: Event hierarchy
  eventId       String?
  event         Event?      @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([departmentId])
  @@index([readiness])
  @@index([planStatus])
  @@index([scheduledDate])
  @@index([storeRegion])
  @@index([regionId])
  @@index([provinceId])
  @@index([teamId])
  documents Document[]
  @@index([eventId])
}

enum StoreRegion {
  BANGKOK
  UPC
}

enum WorkScope {
  INSTALL_CAMERA
  INSTALL_LAN
  INSTALL_POE
  CALIBRATION
  TESTING
  CLOUD_SETUP
  MAINTENANCE
}

enum PlanReadiness {
  PENDING
  NOT_READY
  READY
  ON_HOLD
}

enum PlanStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model PlanStatusHistory {
  id           String           @id @default(uuid())
  planId       String
  plan         InstallationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  fieldChanged String
  oldValue     String?
  newValue     String

  changedById  String?
  changedBy    User?            @relation(fields: [changedById], references: [id], onDelete: SetNull)
  changedAt    DateTime         @default(now())
  note         String?

  @@index([planId])
  @@index([changedAt])
}

// ============================================================
// Notifications (Phase 5)
// ============================================================

model NotificationRule {
  id               String              @id @default(uuid())
  name             String
  description      String?
  enabled          Boolean             @default(true)
  trigger          NotificationTrigger
  triggerTime      String?
  triggerDay       String?
  triggerCondition String?
  daysAhead        Int?
  recipients       String[]
  templateBody     String?             @db.Text

  logs             NotificationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum NotificationTrigger {
  DAILY_AT
  EVENING_DAY_BEFORE
  WEEKLY_AT
  STATUS_CHANGE
  READINESS_READY
  NOT_READY_NEAR
  CAPACITY_OVERFLOW
  HANDOVER_GENERATED
  RESCHEDULED
  TEAM_CHANGED
  PLAN_CREATED
  PHOTO_UPLOADED
}

model NotificationLog {
  id            String             @id @default(uuid())
  ruleId        String?
  rule          NotificationRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  recipient     String
  channel       String             @default("TELEGRAM")
  subject       String?
  body          String             @db.Text
  attachmentUrl String?
  status        NotificationStatus @default(PENDING)
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime           @default(now())

  @@index([ruleId])
  @@index([status])
  @@index([sentAt])
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model PlanCommunicationLog {
  id            String   @id @default(uuid())
  planId        String   @map("plan_id")
  plan          InstallationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  channel       String   // PHONE, EMAIL, LINE, TELEGRAM, ON_SITE, OTHER
  direction     String   // INBOUND, OUTBOUND
  contactedAt   DateTime @default(now()) @map("contacted_at")
  contactPerson String?  @map("contact_person")
  summary       String   @db.Text
  outcome       String?  // CONFIRMED, PENDING_RESPONSE, RESCHEDULED, ISSUE, NO_ANSWER

  recordedById  String?  @map("recorded_by_id")
  recordedBy    User?    @relation("RecordedComms", fields: [recordedById], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([planId])
  @@map("plan_communication_logs")
}

model PlanPhoto {
  id          String   @id @default(uuid())
  planId      String   @map("plan_id")
  plan        InstallationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  category    String   // BEFORE, DURING, AFTER, EQUIPMENT, ISSUE, HANDOVER, OTHER
  caption     String?
  filename    String
  storagePath String   @map("storage_path")
  mimeType    String   @map("mime_type")
  fileSize    Int      @map("file_size")

  uploadedById String? @map("uploaded_by_id")
  uploadedBy   User?   @relation("UploadedPhotos", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now()) @map("created_at")

  @@index([planId])
  @@map("plan_photos")
}

// ============================================================
// Documents (Work Permit + Installation Confirmation)
// ============================================================

model Document {
  id            String      @id @default(uuid())
  planId        String
  plan          InstallationPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  docType       DocType
  docNumber     String      @unique
  payload       Json
  status        DocStatus   @default(DRAFT)
  createdById   String?
  createdBy     User?       @relation("DocCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  finalizedAt   DateTime?
  signedAt      DateTime?
  signedByName  String?
  pdfUrl        String?
  workStartTime String?
  workEndTime   String?
  notes         String?    @db.Text
  poeCount      Int?
  equipmentList Json?
  preInstallChecklist  Json?
  workingChecklist     Json?
  handoverChecklist    Json?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([planId])
  @@index([docType])
  @@index([status])
}

enum DocType {
  WORK_PERMIT
  INSTALLATION_CONFIRM
}

enum DocStatus {
  DRAFT
  FINALIZED
  SIGNED
}

model DocumentSequence {
  date    String  @id
  lastSeq Int
}

// ============================================================
// Region & Province (master data — Apr 30, 2026)
// 7 operational regions + 77 provinces of Thailand.
// ============================================================

model Region {
  id        String   @id @default(uuid())
  code      String   @unique  // BANGKOK, CENTRAL, NORTH, NORTHEAST, EAST, SOUTH, WEST
  name      String              // English name
  nameThai  String              // Thai name
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)

  provinces Province[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])

  plans     InstallationPlan[]
}

model Province {
  id        String   @id @default(uuid())
  code      String   @unique  // BANGKOK, CHIANG_MAI, KHON_KAEN, ...
  name      String              // English name
  nameThai  String              // Thai name
  regionId  String
  region    Region   @relation(fields: [regionId], references: [id], onDelete: Restrict)
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([regionId])
  @@index([code])

  plans     InstallationPlan[]
}

// ============================================================
// Event Reports Module (M1)
// ============================================================
// Add this section to backend/prisma/schema.prisma
// (deploy script will paste it just before "model DocumentSequence")

model Event {
  id              String       @id @default(uuid())
  name            String
  organizer       String?
  venue           String?
  venueType       String       @default("Booth")        // 'Booth' or 'Event'
  startDate       DateTime
  endDate         DateTime
  status          EventStatus  @default(PLANNING)
  profile         EventProfile @default(FULL)           // simple / standard / full
  description     String?      @db.Text
  systemCredit    String       @default("AI People Counting")
  confidential    Boolean      @default(true)
  showPasserby    Boolean      @default(true)

  // Display config
  displayHoursStart       Int    @default(9)
  displayHoursEnd         Int    @default(19)
  dwellMinSec             Int    @default(0)
  dwellMaxSec             Int    @default(3600)
  engagementThresholdSec  Int    @default(60)

  // Sponsor / theme zones (comma-separated for now)
  sponsorZones    String?

  // Linked customer (master data)
  customerId      String?
  customer        Customer?    @relation(fields: [customerId], references: [id], onDelete: SetNull)

  // Hierarchy: Event → many Plans (sub-installations)
  plans           InstallationPlan[]

  // Day-by-day breakdown
  days            EventDay[]
  gates           EventGate[]
  zones           EventZone[]
  activities      EventActivity[]

  // Reports (multiple versions / regenerations)
  reports         EventReport[]

  createdById     String?
  createdBy       User?        @relation("EventCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([startDate])
  @@index([status])
  @@index([customerId])
}

enum EventStatus {
  PLANNING
  IN_PROGRESS
  DATA_COLLECTED
  REPORT_READY
  COMPLETED
  CANCELLED
}

enum EventProfile {
  SIMPLE
  STANDARD
  FULL
}

model EventDay {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  dayNumber   Int                      // 1, 2, 3
  date        DateTime
  label       String                   // e.g. "Day 1", "Opening Day"
  color       String   @default("#1F77B4") // hex color for charts

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([eventId, dayNumber])
  @@index([eventId])
}

model EventGate {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String                     // e.g. "Front Gate", "VIP Entrance"
  gateType  String   @default("ENTRANCE") // ENTRANCE | PASSERBY
  sortOrder Int      @default(0)

  @@index([eventId])
}

model EventZone {
  id         String   @id @default(uuid())
  eventId    String
  event      Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name       String
  abbrev     String?                  // short label for charts
  sortOrder  Int      @default(0)

  @@index([eventId])
}

model EventActivity {
  id          String   @id @default(uuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  date        DateTime                 // YYYY-MM-DD
  startTime   String                   // 'HH:MM'
  endTime     String                   // 'HH:MM'
  name        String
  zone        String?                  // optional zone name
  description String?

  @@index([eventId, date])
}

model EventReport {
  id            String              @id @default(uuid())
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status        EventReportStatus   @default(QUEUED)
  profile       String              @default("full")      // snapshot of profile at gen time

  // Files (relative to /app/uploads/events/<eventId>/)
  rawdataPath   String?                                    // input Excel filename
  htmlPath      String?                                    // output Dashboard.html
  xlsxPath      String?                                    // output Dashboard.xlsx
  htmlSize      Int?
  xlsxSize      Int?

  // Job tracking
  queuedAt      DateTime            @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  durationMs    Int?

  // Errors / logs
  stdout        String?             @db.Text
  stderr        String?             @db.Text
  errorMessage  String?

  // Who triggered this
  triggeredById String?
  triggeredBy   User?               @relation("EventReportTriggeredBy", fields: [triggeredById], references: [id], onDelete: SetNull)

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([eventId])
  @@index([status])
  @@index([createdAt])
}

enum EventReportStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

