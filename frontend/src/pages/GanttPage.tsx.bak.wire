import { useState } from 'react';
import { useQuery } from '@tanstack/react-query';
import { plansApi } from '../api/plans';
import { monthRange } from '../lib/dates';
import { Spinner } from '../components/Spinner';

export function GanttPage() {
  const [cursor, setCursor] = useState(new Date());
  const { from, to, first } = monthRange(cursor);
  const { data, isLoading } = useQuery({
    queryKey: ['plans-gantt', from, to],
    queryFn: () => plansApi.list({ scheduledFrom: from, scheduledTo: to, limit: 200 }),
  });
  const plans = data?.data || [];
  const totalDays = new Date(cursor.getFullYear(), cursor.getMonth() + 1, 0).getDate();
  const today = new Date();

  // group by team
  const grouped = plans.reduce((acc: any, p: any) => {
    const key = p.team?.name || 'Unassigned';
    if (!acc[key]) acc[key] = { team: p.team, plans: [] };
    acc[key].plans.push(p);
    return acc;
  }, {});

  return (
    <div className="space-y-4">
      <div className="flex items-center gap-2">
        <button onClick={() => setCursor(new Date(cursor.getFullYear(), cursor.getMonth() - 1, 1))} className="w-8 h-8 border border-gray-300 rounded hover:bg-gray-100">‹</button>
        <span className="text-base font-medium min-w-[180px] text-center">
          {cursor.toLocaleDateString('en-GB', { month: 'long', year: 'numeric' })}
        </span>
        <button onClick={() => setCursor(new Date(cursor.getFullYear(), cursor.getMonth() + 1, 1))} className="w-8 h-8 border border-gray-300 rounded hover:bg-gray-100">›</button>
        <span className="ml-3 text-xs text-gray-500">{plans.length} jobs</span>
      </div>

      {isLoading ? <Spinner /> : (
        <div className="bg-white rounded-lg border border-gray-200 p-4 overflow-x-auto">
          <div className="grid grid-cols-[180px_1fr] gap-3 items-center pb-2 border-b border-gray-200 text-xs text-gray-500">
            <div>Plan</div>
            <div className="relative h-6">
              {Array.from({ length: totalDays }).map((_, i) => {
                const d = i + 1;
                if (d === 1 || d % 5 === 0) return (
                  <span key={d} className="absolute text-[10px] text-gray-400" style={{ left: `${((d - 1) / totalDays) * 100}%` }}>{d}</span>
                );
                return null;
              })}
            </div>
          </div>

          {Object.entries(grouped).map(([teamName, g]: [string, any]) => (
            <div key={teamName}>
              <div className="pt-3 pb-2 text-xs font-medium text-gray-600 border-t border-gray-100 mt-2">
                {teamName} {g.team && <span className="text-gray-400">· {g.team.region === 'BANGKOK' ? 'Bangkok' : 'Up-country'}</span>}
              </div>
              {g.plans.map((p: any) => {
                const start = new Date(p.scheduledDate);
                const day = start.getMonth() === cursor.getMonth() ? start.getDate() : 1;
                const left = ((day - 1) / totalDays) * 100;
                const width = ((p.durationDays || 1) / totalDays) * 100;
                let bg = 'bg-green-100', text = 'text-green-900';
                if (p.planStatus === 'COMPLETED') { bg = 'bg-emerald-100'; text = 'text-emerald-900'; }
                else if (p.planStatus === 'CONFIRMED') { bg = 'bg-blue-100'; text = 'text-blue-900'; }
                else if (p.readiness === 'NOT_READY') { bg = 'bg-amber-100'; text = 'text-amber-900'; }

                return (
                  <div key={p.id} className="grid grid-cols-[180px_1fr] gap-3 items-center py-1.5 border-b border-gray-100">
                    <div className="text-xs truncate" title={p.storeName}>
                      <span className="font-medium">{p.customer.customerCode}</span> {p.storeName}
                    </div>
                    <div className="relative h-6 bg-gray-100 rounded">
                      {today.getMonth() === cursor.getMonth() && (
                        <div className="absolute top-0 bottom-0 w-0.5 bg-blue-500 z-10"
                          style={{ left: `${((today.getDate() - 0.5) / totalDays) * 100}%` }}></div>
                      )}
                      <div className={`absolute top-0.5 bottom-0.5 rounded ${bg} ${text} px-2 text-[10px] flex items-center overflow-hidden whitespace-nowrap`}
                        style={{ left: `${left}%`, width: `${width}%` }}>
                        {(p.durationDays || 1) > 1 ? `${p.durationDays}d · ${p.storeName}` : p.storeName}
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
          ))}

          {plans.length === 0 && <div className="text-center py-8 text-gray-400 text-sm">No plans this month</div>}
        </div>
      )}
    </div>
  );
}
